{
  "name": "hitel",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "lucide-react": "^1.56.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "predev": "mise install && vp install",
    "build": "vp run --filter @hitel/web build",
    "dev": "vp run --filter @hitel/web dev",
    "preview": "vp run --filter @hitel/web preview",
    "typecheck": "vp run -r typecheck",
    "clean": "vp run -r clean && rm -rf node_modules dist && vp cache clean",
    "ui:add": "vp run --filter @hitel/ui add"
  },
  "devDependencies": {
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.4"
  },
  "packageManager": "bun@1.4.2"
}
