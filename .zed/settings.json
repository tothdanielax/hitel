{
  "formatter": "language_server",
  "format_on_save": "on",
  "semantic_tokens": "combined",
  "languages": {
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "language_servers": ["tsgo", "oxfmt", "oxlint"]
    },
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "language_servers": ["tsgo", "oxfmt", "oxlint"]
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "language_servers": ["tsgo", "tailwindcss-language-server", "oxfmt", "oxlint"]
    },
    "CSS": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "language_servers": ["tailwindcss-language-server", "oxfmt"]
    },
    "HTML": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "language_servers": ["vscode-html-language-server", "oxfmt"]
    },
    "Markdown": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "language_servers": ["markdown-oxide", "oxfmt"]
    },
    "JSON": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "language_servers": ["json-language-server", "package-version-server", "oxfmt"]
    },
    "JSONC": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true,
        "source.organizeImports.oxc": true
      },
      "language_servers": ["json-language-server", "oxfmt"]
    }
  },
  "file_scan_exclusions": [
    // default
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",

    // extra
    "**/dist",
    "**/.vite-hooks/_",
    "**/*lock.yml",
    "**/*lock.yaml"

    // do NOT add node_modules as it breaks import suggests for TS/TSX/JS
    // review this when Zed implements exlusion scopes
    // https://github.com/zed-industries/zed/issues/21018
    // **/node_modules
  ],
  "prettier": {
    "allowed": false
  },
  "lsp": {
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "run": "onSave",
          "typeAware": true,
          "unusedDisableDirectives": "deny",
          "fmt.configPath": "./vite.config.ts"
        }
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onSave",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "error",
          "typeAware": true,
          "typeCheck": true
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva"],
        "experimental": {
          "configFile": "packages/ui/src/styles/globals.css"
        }
      }
    }
  }
}
